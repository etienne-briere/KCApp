<?xml version="1.0" encoding="utf-8"?>
<!--
  Extrait à fusionner dans le manifeste de votre application.

  Une seule permission : la connexion au casque est du TCP vers une adresse du
  réseau local. Aucune permission de localisation ni de Wi-Fi n'est requise.

  `usesCleartextTraffic` est nécessaire parce que le protocole ADB n'est pas
  du HTTPS. Si votre application communique par ailleurs avec des serveurs,
  préférez une politique de sécurité réseau qui n'autorise le trafic en clair
  que vers la plage d'adresses du casque, plutôt que globalement.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:usesCleartextTraffic="true">
        <!-- vos activités -->
    </application>

</manifest>
