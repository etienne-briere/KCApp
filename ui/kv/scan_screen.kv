#:set BLE_BLUE (0.161, 0.502, 0.725, 1)
#:import Window kivy.core.window.Window
#:import KnownDeviceRowBody ui.screens.scan_screen.KnownDeviceRowBody

# ===== Ligne "Appareil connu" faite main (pas TwoLineAvatarIconListItem) =====
# Nécessaire pour avoir un bouton "⋮" (renommer/oublier) à droite sans la
# marge réservée en trop qui tronquerait le sous-titre (voir patterns déjà
# rencontrés sur cet écran). KnownDeviceRowBody porte le ripple + le tap
# pour reconnexion ; le bouton menu est une zone cliquable séparée.
<KnownDeviceRow@MDBoxLayout>:
    orientation: "horizontal"
    size_hint_y: None
    height: dp(72)
    spacing: dp(4)
    padding: 0, 0, dp(8), 0

    KnownDeviceRowBody:
        id: body
        orientation: "horizontal"
        spacing: dp(15)
        padding: dp(16), 0, 0, 0
        size_hint_x: 1

        MDIcon:
            icon: "bluetooth"
            theme_text_color: "Custom"
            text_color: BLE_BLUE
            font_size: "24sp"
            size_hint_x: None
            width: dp(40)
            pos_hint: {"center_y": 0.5}

        MDBoxLayout:
            orientation: "vertical"
            size_hint_x: 1
            size_hint_y: None
            # Hauteur = somme des 2 textes, pas une fraction fixe de la
            # ligne (sinon valign colle les textes aux bords de leur
            # moitié de case respective, avec un grand vide entre eux).
            height: name_label.texture_size[1] + subtitle_label.texture_size[1] + dp(4)
            spacing: dp(4)
            pos_hint: {"center_y": 0.5}

            MDLabel:
                id: name_label
                font_style: "Body1" if Window.width >= dp(600) else "Body2"
                halign: "left"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                shorten: True
                shorten_from: "right"

            MDLabel:
                id: subtitle_label
                theme_text_color: "Custom"
                font_style: "Caption" if Window.width >= dp(600) else "Overline"
                halign: "left"
                valign: "middle"
                text_size: self.width, None
                size_hint_y: None
                height: self.texture_size[1]
                shorten: True
                shorten_from: "right"

    MDIconButton:
        id: menu_button
        icon: "dots-vertical"
        theme_text_color: "Custom"
        text_color: BLE_BLUE
        pos_hint: {"center_y": 0.5}

<ScanScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            id: scan_content
            orientation: "vertical"
            spacing: dp(30)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ===== Détection Bluetooth (toute la card lance le scan) =====
            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(15)
                size_hint_y: None
                height: dp(70)
                elevation: 0
                ripple_behavior: True
                disabled: root.is_busy
                on_release: root.start_ble_scan()

                MDIcon:
                    icon: "bluetooth"
                    theme_text_color: "Custom"
                    text_color: BLE_BLUE
                    font_size: "30sp"
                    size_hint_x: None
                    width: dp(30)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text: "Détection Bluetooth"
                        font_style: "Body1" if Window.width >= dp(600) else "Body2"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text: root.scan_status_text
                        theme_text_color: "Custom"
                        text_color: root.scan_status_color
                        font_style: "Caption" if Window.width >= dp(600) else "Overline"
                        halign: "left"
                        valign: "top"

                # Le spinner prend la place de l'icône loupe (superposés dans
                # le même emplacement plutôt que côte à côte) : un seul des
                # deux est visible à la fois selon root.is_busy.
                FloatLayout:
                    size_hint: None, None
                    size: dp(40), dp(40)
                    pos_hint: {"center_y": 0.5}

                    MDSpinner:
                        size_hint: None, None
                        size: dp(24), dp(24)
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        color: BLE_BLUE
                        active: root.is_busy
                        opacity: 1 if root.is_busy else 0

                    MDIcon:
                        icon: "magnify"
                        theme_text_color: "Custom"
                        text_color: BLE_BLUE
                        font_size: "28sp"
                        pos_hint: {"center_x": 0.5, "center_y": 0.5}
                        opacity: 0 if root.is_busy else 1

            # ===== Données du capteur (titre + card FC) — toujours visible,
            # y compris sans capteur connecté (valeur "--" par défaut, voir
            # ScanScreen.heart_rate_text) =====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "DONNÉES DU CAPTEUR"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    id: data_device_card
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(70)
                    elevation: 0

                    MDIcon:
                        icon: "heart-off" if root.hr_signal_lost else "heart"
                        theme_text_color: "Custom"
                        text_color: "red"
                        font_size: "30sp"
                        size_hint: None, None
                        size: dp(30), dp(30)
                        pos_hint: {"center_y": 0.5}

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDLabel:
                            text: "Fréquence cardiaque"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "bottom" if root.hr_signal_lost else "middle"

                        # ---- Signal perdu : le capteur s'est déconnecté tout seul ----
                        MDLabel:
                            text: "Signal perdu — relancez un scan"
                            theme_text_color: "Custom"
                            text_color: 0.776, 0.157, 0.157, 1
                            font_style: "Caption" if Window.width >= dp(600) else "Overline"
                            halign: "left"
                            valign: "top"
                            size_hint_y: 1 if root.hr_signal_lost else None
                            height: self.texture_size[1] if root.hr_signal_lost else 0
                            opacity: 1 if root.hr_signal_lost else 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_x: None
                        width: self.minimum_width
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: heart_rate_label
                            text: root.heart_rate_text
                            font_style: "H5" if Window.width >= dp(600) else "H6"
                            # Couleur explicite plutôt que theme_text_color "Secondary"/"Primary" :
                            # KivyMD ne recalcule cette dernière qu'à son changement, en gris si
                            # le bloc est alors désactivé (rescan), et ne la rétablit pas ensuite.
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.secondary_text_color if root.hr_signal_lost else app.theme_cls.text_color
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "bpm"
                            font_style: "Caption" if Window.width >= dp(600) else "Overline"
                            theme_text_color: "Secondary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.4}

            # ===== Mes appareils (historique des connexions) =====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.known_devices else 0
                opacity: 1 if root.known_devices else 0
                disabled: not root.known_devices

                MDLabel:
                    text: "MES APPAREILS"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16), dp(1)
                    radius: [12]
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDList:
                        id: known_devices_list
                        size_hint_y: None
                        height: self.minimum_height

            # ===== Appareils détectés (titre + card) =====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.devices_found else 0
                opacity: 1 if root.devices_found else 0
                disabled: not root.devices_found

                MDLabel:
                    text: "APPAREIL(S) DÉTECTÉ(S)"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16), dp(1)
                    radius: [12]
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDList:
                        id: devices_list
                        size_hint_y: None
                        height: self.minimum_height