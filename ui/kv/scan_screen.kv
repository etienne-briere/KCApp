#:set BLE_BLUE (0.161, 0.502, 0.725, 1)

<ScanScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            id: scan_content
            orientation: "vertical"
            spacing: dp(30)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ===== Détection Bluetooth (titre à gauche, action à droite) =====
            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(15)
                size_hint_y: None
                height: dp(70)
                elevation: 0

                MDIcon:
                    icon: "bluetooth"
                    theme_text_color: "Custom"
                    text_color: BLE_BLUE
                    font_size: "30sp"
                    size_hint_x: None
                    width: dp(30)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text: "Détection Bluetooth"
                        font_style: "Body1"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text: root.scan_status_text
                        theme_text_color: "Custom"
                        text_color: root.scan_status_color
                        font_style: "Caption"
                        halign: "left"
                        valign: "top"

                MDSpinner:
                    size_hint: None, None
                    size: dp(24), dp(24)
                    pos_hint: {"center_y": 0.5}
                    active: root.is_busy
                    opacity: 1 if root.is_busy else 0

                MDRaisedButton:
                    text: "SCANNER"
                    md_bg_color: BLE_BLUE
                    text_color: 1, 1, 1, 1
                    font_size: dp(14)
                    _radius: dp(12)
                    pos_hint: {"center_y": 0.5}
                    elevation: 0
                    disabled: root.is_busy
                    on_release: root.start_ble_scan()

            # ===== Données du capteur (titre + card FC) — visible uniquement si connecté =====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.connected_address else 0
                opacity: 1 if root.connected_address else 0
                disabled: not root.connected_address

                MDLabel:
                    text: "DONNÉES DU CAPTEUR"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    id: data_device_card
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(70)
                    elevation: 0

                    MDIcon:
                        icon: "heart"
                        theme_text_color: "Custom"
                        text_color: "red"
                        font_size: "30sp"
                        size_hint: None, None
                        size: dp(30), dp(30)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Fréquence cardiaque"
                        font_style: "Body1"
                        halign: "left"
                        valign: "middle"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_x: None
                        width: self.minimum_width
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: heart_rate_label
                            text: root.heart_rate_text
                            font_style: "H5"
                            theme_text_color: "Primary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "bpm"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.4}

                    MDIconButton:
                        icon: "chart-bell-curve-cumulative"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        icon_size: "26sp"
                        size_hint_x: None
                        width: dp(40)
                        pos_hint: {"center_y": 0.5}
                        on_release:
                            app.root.ids.bottom_nav.ids.tab_manager.get_screen("tracking_tab").dispatch("on_tab_press")

            # ===== Appareils détectés (titre + card) =====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.devices_found else 0
                opacity: 1 if root.devices_found else 0
                disabled: not root.devices_found

                MDLabel:
                    text: "APPAREIL(S) DÉTECTÉ(S)"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16), dp(1)
                    radius: [12]
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDList:
                        id: devices_list
                        size_hint_y: None
                        height: self.minimum_height