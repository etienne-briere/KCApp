#:kivy 2.0
#:import dp kivy.metrics.dp

# Encadré joueur de la top bar (voir ui/widgets/player_chip.py)
<PlayerChip>:
    orientation: "horizontal"
    padding: dp(6), dp(4), dp(6), dp(4)
    spacing: dp(8)
    radius: [dp(18)]
    md_bg_color: 1, 1, 1, 0.18
    elevation: 0
    ripple_behavior: True
    size_hint: None, None
    size: self.minimum_width, dp(36)
    pos_hint: {"center_y": 0.5}
    on_release: app.open_player_profile()

    MDIcon:
        icon: "account-circle"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1
        font_size: "26sp"
        size_hint: None, None
        size: dp(26), dp(26)
        pos_hint: {"center_y": 0.5}

    # Nom + âge dans un même label (âge plus discret, absent sans profil
    # actif) : pas d'espace vide laissé par un label d'âge masqué
    MDLabel:
        text:
            (root.player_name + "  [size=14sp][color=ffffffcc]" + root.player_age + "[/color][/size]") \
            if root.player_name else "Aucun joueur"
        markup: True
        font_style: "Subtitle1"
        theme_text_color: "Custom"
        text_color: 1, 1, 1, 1 if root.player_name else 0.8
        adaptive_size: True
        pos_hint: {"center_y": 0.5}

    # Badge d'état de partie (mêmes couleurs que la bannière Home)
    MDCard:
        padding: dp(8), dp(2)
        radius: [dp(10)]
        md_bg_color: root.game_state_bg
        elevation: 0
        size_hint: None, None
        size: self.minimum_width, dp(22)
        pos_hint: {"center_y": 0.5}

        MDLabel:
            text: root.game_state_label
            font_style: "Caption"
            bold: True
            theme_text_color: "Custom"
            text_color: root.game_state_fg
            adaptive_size: True
            pos_hint: {"center_y": 0.5}
