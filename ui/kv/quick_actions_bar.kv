#:kivy 2.0
#:import dp kivy.metrics.dp
#:import ClippedBox ui.widgets.quick_actions_bar.ClippedBox
#:import HandleToggle ui.widgets.quick_actions_bar.HandleToggle

<QuickActionsBar>:
    size_hint: 1, 1

    # ---------- PANNEAU (icônes d'actions, empilées verticalement) ----------
    ClippedBox:
        id: panel
        orientation: "vertical"
        size_hint: None, None
        # MDIconButton impose un diamètre ~dp(48) (voir plus bas) : la
        # largeur doit lui laisser la place, marge de padding comprise.
        width: dp(64) if root.is_open else 0
        height: dp(320)
        x: handle.x - self.width
        y: handle.center_y - self.height / 2
        opacity: 1 if root.is_open else 0
        padding: dp(4), dp(8)
        spacing: dp(6)
        md_bg_color: app.theme_cls.bg_normal
        disabled: not root.unity_connected

        canvas.after:
            Color:
                rgba: app.theme_cls.divider_color
            Rectangle:
                pos: self.right - dp(1), self.y
                size: dp(1), self.height

        MDIconButton:
            icon: "rocket-launch-outline"
            disabled: root.game_state != "Menu"
            on_release: root.launch_game()

        MDIconButton:
            icon: "pause-circle-outline"
            disabled: root.game_state != "Playing"
            on_release: root.pause_game()

        MDIconButton:
            icon: "play-circle-outline"
            disabled: root.game_state != "Paused"
            on_release: root.resume_game()

        MDIconButton:
            icon: "restart"
            disabled: root.game_state not in ("Playing", "Paused")
            on_release: root.restart_game()

        MDIconButton:
            icon: "arrow-left-circle-outline"
            disabled: root.game_state == "Menu"
            on_release: root.return_to_menu()

        MDIconButton:
            icon: "exit-to-app"
            on_release: root.confirm_quit_game()

    # ---------- LANGUETTE (toujours visible, quel que soit l'écran) ----------
    # AnchorLayout : centre son contenu quelle que soit sa taille réelle.
    # HandleToggle (ButtonBehavior + MDIcon, voir quick_actions_bar.py)
    # garde la taille donnée ci-dessous au lieu du diamètre ~dp(48) que
    # MDIconButton s'impose toujours (cible tactile Material Design) —
    # on veut une languette volontairement étroite.
    AnchorLayout:
        id: handle
        anchor_x: "center"
        anchor_y: "center"
        size_hint: None, None
        size: dp(26), dp(72)
        pos_hint: {"right": 1, "center_y": 0.5}

        canvas.before:
            Color:
                rgba: app.theme_cls.primary_color
            RoundedRectangle:
                pos: self.pos
                size: self.size
                radius: [dp(12), 0, 0, dp(12)]

        HandleToggle:
            size_hint: None, None
            size: dp(24), dp(24)
            icon: "chevron-left" if root.is_open else "chevron-right"
            theme_text_color: "Custom"
            text_color: 1, 1, 1, 1
            font_size: "20sp"
            on_release: root.toggle()
