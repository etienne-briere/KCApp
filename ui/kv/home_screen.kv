#:kivy 2.0
#:import Window kivy.core.window.Window

<HomeScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(30)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== ALERTES DE CONNEXION ====
            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(10)
                size_hint_y: None
                height: dp(70)
                elevation: 0
                canvas.after:
                    Color:
                        rgba: GREEN_FG if root.wifi_connected else RED_FG
                    RoundedRectangle:
                        pos: self.pos
                        size: dp(4), self.height
                        radius: [dp(12), 0, 0, dp(12)]

                MDIcon:
                    icon: "wifi" if root.wifi_connected else "wifi-off"
                    theme_text_color: "Custom"
                    text_color: GREEN_FG if root.wifi_connected else RED_FG
                    font_size: "40sp"
                    size_hint_x: None
                    width: dp(50)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text:
                            ("Wi-Fi connecté : " + root.wifi_ssid) \
                            if root.wifi_connected and root.wifi_ssid else \
                            ("Wi-Fi connecté" if root.wifi_connected else "Wi-Fi désactivé")
                        font_style: "H6"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text: "Connectez-vous sur le même réseau que votre casque VR"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "left"
                        valign: "top"

            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(10)
                size_hint_y: None
                height: dp(70)
                elevation: 0
                canvas.after:
                    Color:
                        rgba: GREEN_FG if root.hr_sensor_connected else RED_FG
                    RoundedRectangle:
                        pos: self.pos
                        size: dp(4), self.height
                        radius: [dp(12), 0, 0, dp(12)]

                MDIcon:
                    icon: "heart" if root.hr_sensor_connected else "heart-off"
                    theme_text_color: "Custom"
                    text_color: GREEN_FG if root.hr_sensor_connected else RED_FG
                    font_size: "40sp"
                    size_hint_x: None
                    width: dp(50)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text: "Capteur FC connecté" if root.hr_sensor_connected else "Capteur FC déconnecté"
                        font_style: "H6"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text:
                            ("Connecté à " + (root.hr_sensor_name or "votre capteur") + " — envoi en cours…") \
                            if root.hr_data_sent else \
                            ("En attente de connexion du jeu…" if root.hr_sensor_connected else "Connectez votre capteur FC")
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "left"
                        valign: "top"

                AnchorLayout:
                    anchor_x: "right"
                    anchor_y: "center"
                    size_hint_x: None
                    width: bpm_box.minimum_width if root.hr_sensor_connected else dp(48)

                    MDIconButton:
                        icon: "bluetooth-connect"
                        theme_text_color: "Custom"
                        text_color: RED_FG
                        icon_size: "30sp"
                        opacity: 0 if root.hr_sensor_connected else 1
                        disabled: root.hr_sensor_connected
                        on_release:
                            app.root.ids.bottom_nav.ids.tab_manager.get_screen("scan_tab").dispatch("on_tab_press")

                    MDBoxLayout:
                        id: bpm_box
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_x: None
                        width: self.minimum_width
                        opacity: 1 if root.hr_sensor_connected else 0

                        MDLabel:
                            text: root.heart_rate_text
                            font_style: "H5"
                            theme_text_color: "Primary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "bpm"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.4}

            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(10)
                size_hint_y: None
                height: dp(70)
                elevation: 0
                canvas.after:
                    Color:
                        rgba: GREEN_FG if root.unity_connected else RED_FG
                    RoundedRectangle:
                        pos: self.pos
                        size: dp(4), self.height
                        radius: [dp(12), 0, 0, dp(12)]

                MDIcon:
                    icon: "unity" if root.unity_connected else "lan-disconnect"
                    theme_text_color: "Custom"
                    text_color: GREEN_FG if root.unity_connected else RED_FG
                    font_size: "40sp"
                    size_hint_x: None
                    width: dp(50)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text: "Jeu connecté" if root.unity_connected else "Jeu déconnecté"
                        font_style: "H6"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text:
                            ("Connecté à " + root.unity_ip) if root.unity_connected else \
                            "Appuyez sur le bouton pour relancer la recherche du casque"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "left"
                        valign: "top"

                AnchorLayout:
                    anchor_x: "center"
                    anchor_y: "center"
                    size_hint_x: None
                    width: dp(48)

                    MDIconButton:
                        icon: "refresh"
                        theme_text_color: "Custom"
                        text_color: RED_FG
                        icon_size: "30sp"
                        opacity: 0 if root.unity_connected else 1
                        disabled: root.unity_connected
                        on_release: root.force_reconnect()

                    MDIconButton:
                        icon: "microsoft-xbox-controller-menu"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        icon_size: "30sp"
                        opacity: 1 if root.unity_connected else 0
                        disabled: not root.unity_connected
                        on_release:
                            app.root.ids.bottom_nav.ids.tab_manager.get_screen("pilotage_tab").dispatch("on_tab_press")

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(20)
                size_hint: 1, None
                height: self.minimum_height if root.unity_connected else 0
                opacity: 1 if root.unity_connected else 0
                disabled: 0 if root.unity_connected else 1

                MDLabel:
                    text: "Session en cours"
                    font_style: "H5"
                    halign: "left"

                # ==== Joueur + état de la partie ====
                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    elevation: 0
                    size_hint_y: None
                    height: dp(70)

                    MDIcon:
                        icon: "account"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        font_size: "40sp"
                        size_hint_x: None
                        width: dp(50)

                    MDBoxLayout:
                        orientation: "vertical"
                        spacing: dp(2)

                        MDLabel:
                            text: root.player_name if root.player_name else "Nom inconnu"
                            font_style: "H6"
                            halign: "left"
                            valign: "bottom"

                        MDLabel:
                            text: "Joueur"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            halign: "left"
                            valign: "top"

                    AnchorLayout:
                        anchor_x: "right"
                        anchor_y: "center"
                        size_hint_x: None
                        width: state_badge.width

                        MDBoxLayout:
                            id: state_badge
                            orientation: "horizontal"
                            spacing: dp(6)
                            padding: dp(10), dp(4)
                            size_hint: None, None
                            size: self.minimum_width, dp(30)
                            pos_hint: {"center_y": 0.5}
                            canvas.before:
                                Color:
                                    rgba: root.game_state_bg
                                RoundedRectangle:
                                    pos: self.pos
                                    size: self.size
                                    radius: [dp(15)]

                            MDIcon:
                                icon: "circle"
                                theme_text_color: "Custom"
                                text_color: root.game_state_fg
                                font_size: "12sp"
                                size_hint: None, None
                                size: dp(12), dp(12)
                                pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: root.game_state
                                theme_text_color: "Custom"
                                text_color: root.game_state_fg
                                font_style: "Caption"
                                bold: True
                                adaptive_size: True
                                pos_hint: {"center_y": 0.5}

                # ==== Mode de jeu / FC cible / Temps restant ====
                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    elevation: 0
                    size_hint_y: None
                    height: dp(100)

                    # ===== Affichage du modèle sélectionné dans Unity ====
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"

                        # Label
                        MDLabel:
                            id: selected_model
                            text: root.selected_model
                            font_style: "Body1"
                            halign: "center"

                    # ==== Séparateur ====
                    Widget:
                        size_hint_x: None
                        width: dp(1)
                        canvas:
                            Color:
                                rgba: app.theme_cls.divider_color
                            Rectangle:
                                pos: self.pos
                                size: self.size

                    # ===== %FC Cible choisi ====
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(5)
                            # size_hint_x: 1

                            Widget:
                            MDIcon:
                                icon: "target"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "30sp"
                                pos_hint: {'center_y': 0.5}

                            # Label
                            MDLabel:
                                text: root.hr_target
                                font_style: "Body1"
                                halign: "center"
                            Widget:

                    # ==== Séparateur ====
                    Widget:
                        size_hint_x: None
                        width: dp(1)
                        canvas:
                            Color:
                                rgba: app.theme_cls.divider_color
                            Rectangle:
                                pos: self.pos
                                size: self.size

                    # ===== Temps de session restant ====
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(5)

                            Widget:
                            MDIcon:
                                icon: "timer-outline"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "30sp"
                                pos_hint: {'center_y': 0.5}

                            # Label
                            MDLabel:
                                text: root.session_remaining_text
                                font_style: "Body1"
                                halign: "center"
                            Widget:

                # ==== Entrée âge joueur ====
                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    elevation: 0
                    size_hint_y: None
                    height: dp(70)

                    MDTextField:
                        id: age_input
                        text: root.age_user
                        hint_text: "Âge"
                        helper_text: "Entrez l'âge du joueur"
                        icon_left: "human-child"
                        helper_text_mode: "on_focus"
                        input_filter: "int"
                        mode: "rectangle"
                        text_color_focus: app.theme_cls.primary_color
                        hint_text_color_focus: app.theme_cls.primary_color
                        line_color_focus: app.theme_cls.primary_color
                        icon_left_color_focus: app.theme_cls.primary_color
                        helper_text_color_focus: app.theme_cls.primary_color

                    MDIconButton:
                        icon: "send-outline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        size_hint: None, None
                        icon_size: "30sp"
                        on_release: root.send_new_age()
