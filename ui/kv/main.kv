#:import MDTopAppBar kivymd.uix.toolbar
#:import Window kivy.core.window.Window
#:import NoTransition kivy.uix.screenmanager.NoTransition

#:import StatusBar ui.widgets.status_bar.StatusBar
#:import QuickActionsBar ui.widgets.quick_actions_bar.QuickActionsBar
#:import HomeScreen ui.screens.home_screen.HomeScreen
#:import ScanScreen ui.screens.scan_screen.ScanScreen
#:import TrackingScreen ui.screens.tracking_screen.TrackingScreen
#:import ProfilScreen ui.screens.profil_screen.ProfilScreen
#:import ControlMenuScreen ui.screens.control_menu_screen.ControlMenuScreen
#:import HeadsetScreen ui.screens.headset_screen.HeadsetScreen
#:import PilotageScreen ui.screens.pilotage_screen.PilotageScreen
#:import PlayerProfileScreen ui.screens.player_profile_screen.PlayerProfileScreen
#:import GameScreen ui.screens.game_screen.GameScreen

BoxLayout:
    orientation: "vertical"

    canvas.before:
        Color:
            rgba: (0.941, 0.941, 0.953, 1)
        Rectangle:
            pos: self.pos
            size: self.size

    # ---------- TOP BAR ----------
    # height explicite : masquée (0) quand app.chrome_visible est False
    # (plein écran vidéo — voir GameScreen.toggle_fullscreen), sinon la
    # hauteur que KivyMD aurait calculée elle-même selon l'appareil.
    MDTopAppBar:
        id: top_bar
        title: "Accueil"
        md_bg_color: app.theme_cls.primary_color
        # Pas d'icône à gauche : l'encadré joueur ajouté par KCApp.on_start
        # (ui/widgets/player_chip.py) sert de bouton profil
        left_action_items: []
        right_action_items: [["", lambda x: print(x)]]
        height: self.theme_cls.standard_increment if app.chrome_visible else 0

    # -------- SUIVI BLE / Wi-Fi / FC ------
    StatusBar:
        id: status_bar
        height: dp(30) if app.chrome_visible else 0

    # ---------- SCREEN MANAGER + ACTIONS RAPIDES ----------
    # FloatLayout : la barre d'actions rapides flotte par-dessus l'écran
    # affiché (quel qu'il soit) sans redimensionner top bar / status bar /
    # bottom nav quand elle se déplie.
    FloatLayout:
        id: screen_area

        ScreenManager:
            id: screen_manager
            size_hint: 1, 1
            pos: screen_area.pos
            transition: NoTransition()

            HomeScreen:
                name: "home"

            ScanScreen:
                name: "scan"

            TrackingScreen:
                name: "tracking"

            ProfilScreen:
                name: "profil"

            ControlMenuScreen:
                name: "control_menu"

            HeadsetScreen:
                name: "headset"

            PilotageScreen:
                name: "pilotage"

            PlayerProfileScreen:
                name: "player_profile"

            GameScreen:
                name: "game"

        QuickActionsBar:
            id: quick_actions_bar
            pos: screen_area.pos
            opacity: 1 if app.chrome_visible else 0
            disabled: not app.chrome_visible

    # ---------- BOTTOM NAVIGATION (FIXE) ----------
    # height explicite : masquée (0) en plein écran vidéo, comme la top bar
    # et la status bar ci-dessus (voir GameScreen.toggle_fullscreen).
    MDBottomNavigation:
        id: bottom_nav
        size_hint_y: None
        height: dp(81) if app.chrome_visible else 0
        use_text: Window.width >= dp(600)
        transition: NoTransition
		
        MDBottomNavigationItem:
            name: "home_tab"
            text: "Accueil"
            icon: "home"
            on_tab_press:
                app.change_screen("home", "Accueil")

        MDBottomNavigationItem:
            name: "scan_tab"
            text: "Capteur"
            icon: "heart-pulse"
            on_tab_press:
                app.change_screen("scan", "Connexion capteur")

        MDBottomNavigationItem:
            name: "tracking_tab"
            text: "Suivi FC"
            icon: "chart-bell-curve-cumulative"
            on_tab_press:
                app.change_screen("tracking", "Suivi de la fréquence cardiaque")

        MDBottomNavigationItem:
            name: "game_tab"
            text: "Vue joueur"
            icon: "video"
            on_tab_press:
                app.change_screen("game", "Vue du joueur")

        MDBottomNavigationItem:
            name: "pilotage_tab"
            text: "Contrôle"
            icon: "microsoft-xbox-controller-menu"
            on_tab_press:
                app.change_screen("control_menu", "Contrôle")

