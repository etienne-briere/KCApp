#:kivy 2.0
#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window

<SettingsScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(0), dp(0), dp(0), dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== BOUTONS +/- ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                padding: (dp(20), 0) if Window.width >= dp(600) else (dp(8), 0)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "BOUTONS +/-"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "plus-minus-variant"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Pas des boutons +/-"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "center"

                    MDTextField:
                        id: hr_step_field
                        text: str(app.settings_store.hr_step)
                        hint_text: "Pas %FCmax cible"
                        icon_left: "plus-minus-variant"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: LIGHT_GREEN_FG
                        hint_text_color_focus: LIGHT_GREEN_FG
                        line_color_focus: LIGHT_GREEN_FG
                        icon_left_color_normal: PASTEL_GREEN_FG
                        icon_left_color_focus: PASTEL_GREEN_FG
                        on_text_validate: root.on_hr_step_submit(self.text)
                        on_focus: root.on_hr_step_submit(self.text) if not self.focus else None

                    MDTextField:
                        id: cpm_step_field
                        text: str(app.settings_store.cpm_step)
                        hint_text: "Pas cadence (cpm)"
                        icon_left: "plus-minus-variant"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: BLUE_FG
                        hint_text_color_focus: BLUE_FG
                        line_color_focus: BLUE_FG
                        icon_left_color_normal: PASTEL_BLUE_FG
                        icon_left_color_focus: PASTEL_BLUE_FG
                        on_text_validate: root.on_cpm_step_submit(self.text)
                        on_focus: root.on_cpm_step_submit(self.text) if not self.focus else None

            # ==== FLUIDITÉ / QUALITÉ D'IMAGE (Vue du joueur) ====
            # Même réglages que l'écran Vue du joueur (StreamSettings partagée
            # via app.stream_settings) : un changement ici est repris dès la
            # prochaine ouverture de cet écran, sans redémarrer l'app.
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                padding: (dp(20), 0) if Window.width >= dp(600) else (dp(8), 0)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "FLUIDITÉ"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "speedometer"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Images par seconde par défaut"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "center"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8) if Window.width >= dp(600) else dp(4)
                        size_hint_y: None
                        height: dp(40)

                        MDFillRoundFlatButton:
                            text: "2 img/s" if Window.width >= dp(600) else "2"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.fps_choice == 2 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.fps_choice == 2 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(fps=2)

                        MDFillRoundFlatButton:
                            text: "4 img/s" if Window.width >= dp(600) else "4"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.fps_choice == 4 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.fps_choice == 4 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(fps=4)

                        MDFillRoundFlatButton:
                            text: "8 img/s" if Window.width >= dp(600) else "8"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.fps_choice == 8 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.fps_choice == 8 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(fps=8)

                        MDFillRoundFlatButton:
                            text: "12 img/s" if Window.width >= dp(600) else "12"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.fps_choice == 12 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.fps_choice == 12 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(fps=12)

            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                padding: (dp(20), 0) if Window.width >= dp(600) else (dp(8), 0)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "QUALITÉ D'IMAGE"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "image-size-select-large"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Résolution par défaut"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "center"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(8) if Window.width >= dp(600) else dp(4)
                        size_hint_y: None
                        height: dp(40)

                        MDFillRoundFlatButton:
                            text: "320 px" if Window.width >= dp(600) else "320"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.width_choice == 320 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.width_choice == 320 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(width=320)

                        MDFillRoundFlatButton:
                            text: "480 px" if Window.width >= dp(600) else "480"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.width_choice == 480 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.width_choice == 480 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(width=480)

                        MDFillRoundFlatButton:
                            text: "640 px" if Window.width >= dp(600) else "640"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.width_choice == 640 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.width_choice == 640 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(width=640)

                        MDFillRoundFlatButton:
                            text: "800 px" if Window.width >= dp(600) else "800"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.width_choice == 800 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.width_choice == 800 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(width=800)

                        MDFillRoundFlatButton:
                            text: "960 px" if Window.width >= dp(600) else "960"
                            font_size: "13sp" if Window.width >= dp(600) else "11sp"
                            padding: (dp(16), dp(8)) if Window.width >= dp(600) else (dp(6), dp(4))
                            md_bg_color: GREEN_BG if root.width_choice == 960 else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.width_choice == 960 else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(40)
                            on_release: root.set_stream_option(width=960)
