#:kivy 2.0
#:import dp kivy.metrics.dp

<PilotageScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== OBSTACLES ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "OBSTACLES"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(70)
                    elevation: 0

                    MDIcon:
                        icon: "cube-outline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        font_size: "30sp"
                        size_hint_x: None
                        width: dp(30)

                    MDLabel:
                        text: "Obstacles"
                        font_style: "Body1"
                        halign: "left"
                        valign: "center"

                    MDSwitch:
                        id: obstacles_switch
                        active: root.obs_enabled
                        pos_hint: {"center_y": 0.5}
                        size_hint_x: None
                        width: dp(60)
                        on_active: root.on_obstacles_toggle(self.active)
                        disabled: not root.unity_connected

            # ==== CUBES PAR MINUTE ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "CUBES PAR MINUTE"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(130)
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "speedometer"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Cubes par minute"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDLabel:
                            text: "{} /min".format(int(root.cube_per_min))
                            font_style: "H6"
                            theme_text_color: "Primary"
                            halign: "right"

                    MDSlider:
                        id: cube_frequency_slider
                        min: 15
                        max: 120
                        value: root.cube_per_min
                        step: 1
                        hint: True
                        hint_text: "{} /min".format(int(self.value))
                        on_value: root.on_cube_frequency_change(self.value)
                        on_touch_up: root.on_cube_frequency_touch_up() if self.collide_point(*args[1].pos) else None

            # ==== FC CIBLE ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "FC CIBLE"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(130)
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "target"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "FC cible"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDLabel:
                            text: "{} % FCmax".format(int(root.target_hr))
                            font_style: "H6"
                            theme_text_color: "Primary"
                            halign: "right"

                    MDSlider:
                        id: target_hr_slider
                        min: 10
                        max: 100
                        value: root.target_hr
                        step: 1
                        hint: True
                        hint_text: "{}%".format(int(self.value))
                        on_value: root.on_target_hr_change(self.value)
                        on_touch_up: root.on_target_hr_touch_up() if self.collide_point(*args[1].pos) else None

            # ==== ACTIONS DU JEU ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "ACTIONS DU JEU"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    size_hint_y: None
                    height: dp(90)
                    elevation: 0
                    disabled: not root.unity_connected

                    Widget:

                    MDIconButton:
                        icon: "pause-circle-outline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        icon_size: "50sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.pause_game()

                    MDIconButton:
                        icon: "play-circle-outline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        icon_size: "50sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.resume_game()

                    MDIconButton:
                        icon: "restart"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        icon_size: "50sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.restart_game()

                    Widget:
