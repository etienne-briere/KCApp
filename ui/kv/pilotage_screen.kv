#:kivy 2.0
#:import dp kivy.metrics.dp

<PilotageScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== PROFIL DU JOUEUR ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "JOUEUR"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected or root.game_state != "Menu"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "account"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Joueur"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    MDRectangleFlatIconButton:
                        id: player_selector_button
                        text: root.player_name if root.player_name else "Aucun joueur sélectionné"
                        icon: "account-switch"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        on_release: root.open_player_menu(self)

                # ---- Alerte : changement de joueur limité au menu du jeu ----
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(6)
                    padding: dp(16), 0
                    size_hint_y: None
                    height: dp(20) if root.unity_connected and root.game_state != "Menu" else 0
                    opacity: 1 if root.unity_connected and root.game_state != "Menu" else 0

                    MDIcon:
                        icon: "information-outline"
                        theme_text_color: "Custom"
                        text_color: AMBER_FG
                        font_size: "16sp"
                        size_hint: None, None
                        size: dp(16), dp(20)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Changement de joueur disponible uniquement dans le menu du jeu"
                        theme_text_color: "Custom"
                        text_color: AMBER_FG
                        font_style: "Caption"
                        halign: "left"
                        valign: "center"

            # ==== ENVIRONNEMENT ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "ENVIRONNEMENT"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected or root.game_state != "Menu"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "image-filter-hdr"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Environnement"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    MDRectangleFlatIconButton:
                        id: environment_selector_button
                        text: root.ENVIRONMENT_LABELS.get(root.environment, root.environment) if root.environment else "Environnement inconnu"
                        icon: "earth"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        on_release: root.open_environment_menu(self)

                # ---- Alerte : changement d'environnement limité au menu du jeu ----
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(6)
                    padding: dp(16), 0
                    size_hint_y: None
                    height: dp(20) if root.unity_connected and root.game_state != "Menu" else 0
                    opacity: 1 if root.unity_connected and root.game_state != "Menu" else 0

                    MDIcon:
                        icon: "information-outline"
                        theme_text_color: "Custom"
                        text_color: AMBER_FG
                        font_size: "16sp"
                        size_hint: None, None
                        size: dp(16), dp(20)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Changement d'environnement disponible uniquement dans le menu du jeu"
                        theme_text_color: "Custom"
                        text_color: AMBER_FG
                        font_style: "Caption"
                        halign: "left"
                        valign: "center"

            # ==== MODE DE JEU ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "MODE DE JEU"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "cog-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Mode de jeu"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    MDRectangleFlatIconButton:
                        id: model_selector_button
                        text: root.MODEL_LABELS[root.pending_model]
                        icon: "menu-swap"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        on_release: root.open_model_menu(self)

                    # ---- Options du mode Fixe ----
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        size_hint_y: None
                        height: fixe_options_content.height if root.pending_model == "FIXE" else 0
                        opacity: 1 if root.pending_model == "FIXE" else 0
                        disabled: root.pending_model != "FIXE"

                        MDBoxLayout:
                            id: fixe_options_content
                            orientation: "vertical"
                            padding: 0, dp(12), 0, 0
                            spacing: dp(10)
                            size_hint_y: None
                            height: self.minimum_height

                            MDTextField:
                                id: cube_frequency_field
                                text: str(int(root.cube_per_min))
                                hint_text: "Cubes par minute"
                                icon_left: "speedometer"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_cube_frequency_submit(self.text)
                                on_focus: root.on_cube_frequency_submit(self.text) if not self.focus else None

                    # ---- Options du mode Incrémental ----
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        size_hint_y: None
                        height: incremental_options_content.height if root.pending_model == "INCREMENTAL" else 0
                        opacity: 1 if root.pending_model == "INCREMENTAL" else 0
                        disabled: root.pending_model != "INCREMENTAL"

                        MDBoxLayout:
                            id: incremental_options_content
                            orientation: "horizontal"
                            padding: 0, dp(12), 0, 0
                            spacing: dp(10)
                            size_hint_y: None
                            height: self.minimum_height

                            MDTextField:
                                id: incremental_steps_field
                                text: str(int(root.incremental_steps))
                                hint_text: "Nombre de paliers"
                                icon_left: "stairs"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_incremental_steps_submit(self.text)
                                on_focus: root.on_incremental_steps_submit(self.text) if not self.focus else None

                            MDTextField:
                                id: incremental_min_cpm_field
                                text: str(int(root.incremental_min_cpm))
                                hint_text: "Cpm minimum"
                                icon_left: "arrow-collapse-down"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_incremental_min_cpm_submit(self.text)
                                on_focus: root.on_incremental_min_cpm_submit(self.text) if not self.focus else None

                            MDTextField:
                                id: incremental_max_cpm_field
                                text: str(int(root.incremental_max_cpm))
                                hint_text: "Cpm maximum"
                                icon_left: "arrow-collapse-up"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_incremental_max_cpm_submit(self.text)
                                on_focus: root.on_incremental_max_cpm_submit(self.text) if not self.focus else None

                    # ---- Options des modes PID / DRL ----
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        size_hint_y: None
                        height: pid_drl_options_content.height if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                        opacity: 1 if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                        disabled: root.pending_model not in ("PID", "DRL", "DRL_RUN3")

                        MDBoxLayout:
                            id: pid_drl_options_content
                            orientation: "vertical"
                            padding: 0, dp(12), 0, 0
                            spacing: dp(14)
                            size_hint_y: None
                            height: self.minimum_height

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(10)
                                size_hint_y: None
                                height: self.minimum_height

                                MDTextField:
                                    id: target_hr_field
                                    text: str(int(root.target_hr))
                                    hint_text: "FC cible (% FCmax)"
                                    icon_left: "target"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: app.theme_cls.primary_color
                                    hint_text_color_focus: app.theme_cls.primary_color
                                    line_color_focus: app.theme_cls.primary_color
                                    icon_left_color_focus: app.theme_cls.primary_color
                                    on_text_validate: root.on_target_hr_submit(self.text)
                                    on_focus: root.on_target_hr_submit(self.text) if not self.focus else None
    
                                MDTextField:
                                    id: adaptive_min_cpm_field
                                    text: str(int(root.adaptive_min_cpm))
                                    hint_text: "Cpm minimum"
                                    icon_left: "arrow-collapse-down"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: app.theme_cls.primary_color
                                    hint_text_color_focus: app.theme_cls.primary_color
                                    line_color_focus: app.theme_cls.primary_color
                                    icon_left_color_focus: app.theme_cls.primary_color
                                    on_text_validate: root.on_adaptive_min_cpm_submit(self.text)
                                    on_focus: root.on_adaptive_min_cpm_submit(self.text) if not self.focus else None
    
                                MDTextField:
                                    id: adaptive_max_cpm_field
                                    text: str(int(root.adaptive_max_cpm))
                                    hint_text: "Cpm maximum"
                                    icon_left: "arrow-collapse-up"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: app.theme_cls.primary_color
                                    hint_text_color_focus: app.theme_cls.primary_color
                                    line_color_focus: app.theme_cls.primary_color
                                    icon_left_color_focus: app.theme_cls.primary_color
                                    on_text_validate: root.on_adaptive_max_cpm_submit(self.text)
                                    on_focus: root.on_adaptive_max_cpm_submit(self.text) if not self.focus else None
    
                            # ---- PID de secours (modes DRL, prochaine partie) ----
                            ScrollView:
                                do_scroll_x: False
                                do_scroll_y: False
                                size_hint_y: None
                                height: dp(36) if root.pending_model in root.DRL_MODES else 0
                                opacity: 1 if root.pending_model in root.DRL_MODES else 0
                                disabled: root.pending_model not in root.DRL_MODES

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    spacing: dp(15)
                                    size_hint_y: None
                                    height: dp(36)

                                    MDIcon:
                                        icon: "shield-refresh-outline"
                                        theme_text_color: "Custom"
                                        text_color: app.theme_cls.primary_color
                                        font_size: "26sp"
                                        size_hint: None, None
                                        size: dp(30), dp(30)
                                        pos_hint: {"center_y": 0.5}

                                    MDLabel:
                                        text: "PID de secours (si cycle limite)"
                                        font_style: "Body1"
                                        halign: "left"
                                        valign: "center"

                                    MDCheckbox:
                                        id: pid_backup_checkbox
                                        active: root.pid_backup
                                        pos_hint: {"center_y": 0.5}
                                        size_hint: None, None
                                        size: dp(36), dp(36)
                                        on_active: root.on_pid_backup_toggle(self.active)
                                        disabled: not root.unity_connected

                    # ---- Signal FC requis (modes Fixe / Incrémental) ----
                    ScrollView:
                        do_scroll_x: False
                        do_scroll_y: False
                        size_hint_y: None
                        height: dp(36) if root.pending_model in ("FIXE", "INCREMENTAL") else 0
                        opacity: 1 if root.pending_model in ("FIXE", "INCREMENTAL") else 0
                        disabled: root.pending_model not in ("FIXE", "INCREMENTAL")

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(36)

                            MDIcon:
                                icon: "heart-pulse"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "26sp"
                                size_hint: None, None
                                size: dp(30), dp(30)
                                pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Signal FC requis"
                                font_style: "Body1"
                                halign: "left"
                                valign: "center"

                            MDCheckbox:
                                id: require_hr_signal_checkbox
                                active: root.require_hr_signal
                                pos_hint: {"center_y": 0.5}
                                size_hint: None, None
                                size: dp(36), dp(36)
                                on_active: root.on_require_hr_signal_toggle(self.active)
                                disabled: not root.unity_connected

                # ---- Alerte signal FC requis (modes PID / DRL) ----
                ScrollView:
                    do_scroll_x: False
                    do_scroll_y: False
                    size_hint_y: None
                    height: dp(20) if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                    opacity: 1 if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                    disabled: root.pending_model not in ("PID", "DRL", "DRL_RUN3")

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(6)
                        padding: dp(16), 0
                        size_hint_y: None
                        height: dp(20)

                        MDIcon:
                            icon: "information-outline"
                            theme_text_color: "Custom"
                            text_color: AMBER_FG
                            font_size: "16sp"
                            size_hint: None, None
                            size: dp(16), dp(20)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Ce mode nécessite un signal FC valide pour fonctionner"
                            theme_text_color: "Custom"
                            text_color: AMBER_FG
                            font_style: "Caption"
                            halign: "left"
                            valign: "center"

            # ==== ÉCHAUFFEMENT (modes PID/DRL) ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                opacity: 1 if root.pending_model in ("PID", "DRL", "DRL_RUN3") else 0
                disabled: root.pending_model not in ("PID", "DRL", "DRL_RUN3")

                MDLabel:
                    text: "ÉCHAUFFEMENT"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "timer-play-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Échauffement"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    # ---- Aucun / PID / DRL : qui pilote pendant l'échauffement
                    # (rampe de cible). DRL masqué en mode PID pur, où le choix
                    # ne porte que sur warmup_enabled (voir on_warmup_mode_select) ----
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(48)

                        MDFillRoundFlatButton:
                            text: "Aucun"
                            md_bg_color: RED_BG if not root.warmup_enabled else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: RED_FG if not root.warmup_enabled else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            disabled: not root.unity_connected
                            on_release: root.on_warmup_mode_select("none")

                        MDFillRoundFlatButton:
                            text: "PID"
                            md_bg_color: GREEN_BG if root.warmup_enabled and (root.pid_warmup or root.pending_model not in root.DRL_MODES) else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.warmup_enabled and (root.pid_warmup or root.pending_model not in root.DRL_MODES) else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            disabled: not root.unity_connected
                            on_release: root.on_warmup_mode_select("pid")

                        MDFillRoundFlatButton:
                            text: "DRL"
                            md_bg_color: GREEN_BG if root.warmup_enabled and not root.pid_warmup else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.warmup_enabled and not root.pid_warmup else GRAY_FG
                            size_hint_x: 1 if root.pending_model in root.DRL_MODES else 0
                            size_hint_y: None
                            height: dp(48)
                            opacity: 1 if root.pending_model in root.DRL_MODES else 0
                            disabled: not root.unity_connected or root.pending_model not in root.DRL_MODES
                            on_release: root.on_warmup_mode_select("drl")

                    # ---- Durée du warmup : toujours visible, désactivée si "Aucun" ----
                    MDTextField:
                        id: warmup_duration_field
                        text: str(int(root.warmup_duration))
                        hint_text: "Durée du warmup (s)"
                        icon_left: "timer-sand"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: app.theme_cls.primary_color
                        hint_text_color_focus: app.theme_cls.primary_color
                        line_color_focus: app.theme_cls.primary_color
                        icon_left_color_focus: app.theme_cls.primary_color
                        disabled: not root.unity_connected or not root.warmup_enabled
                        on_text_validate: root.on_warmup_duration_submit(self.text)
                        on_focus: root.on_warmup_duration_submit(self.text) if not self.focus else None

            # ==== OPTIONS GÉNÉRALES (indépendantes du mode de jeu) ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "OPTIONS GÉNÉRALES"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(12)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    # ---- Durée de session ----
                    MDTextField:
                        id: session_duration_field
                        text: str(int(root.session_duration_min))
                        hint_text: "Durée de session (min)"
                        icon_left: "timer-outline"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: app.theme_cls.primary_color
                        hint_text_color_focus: app.theme_cls.primary_color
                        line_color_focus: app.theme_cls.primary_color
                        icon_left_color_focus: app.theme_cls.primary_color
                        on_text_validate: root.on_session_duration_submit(self.text)
                        on_focus: root.on_session_duration_submit(self.text) if not self.focus else None

                    # ---- Vitesse des briques ----
                    MDTextField:
                        id: brick_speed_field
                        text: str(int(root.brick_speed))
                        hint_text: "Vitesse des briques"
                        icon_left: "cube-send"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: app.theme_cls.primary_color
                        hint_text_color_focus: app.theme_cls.primary_color
                        line_color_focus: app.theme_cls.primary_color
                        icon_left_color_focus: app.theme_cls.primary_color
                        on_text_validate: root.on_brick_speed_submit(self.text)
                        on_focus: root.on_brick_speed_submit(self.text) if not self.focus else None

                    # ---- Probabilité d'apparition des obstacles ----
                    MDBoxLayout:
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height if root.obs_enabled else 0
                        opacity: 1 if root.obs_enabled else 0
                        disabled: not root.obs_enabled

                        MDTextField:
                            id: obstacle_probability_field
                            text: str(int(root.obstacle_probability))
                            hint_text: "Probabilité d'apparition (obstacles)"
                            icon_left: "percent"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            on_text_validate: root.on_obstacle_probability_submit(self.text)
                            on_focus: root.on_obstacle_probability_submit(self.text) if not self.focus else None

                    # ---- Séparateur ----
                    Widget:
                        size_hint_y: None
                        height: dp(1)
                        canvas:
                            Color:
                                rgba: app.theme_cls.divider_color
                            Rectangle:
                                pos: self.pos
                                size: self.size

                    # ---- Obstacles ----
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "cube-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Obstacles"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: obstacles_checkbox
                            active: root.obs_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_obstacles_toggle(self.active)

                    # ---- Mains actives ----
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "hand-back-left"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "26sp"
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Main gauche"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: left_hand_checkbox
                            active: root.left_hand_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_left_hand_toggle(self.active)

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "hand-back-right"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "26sp"
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Main droite"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: right_hand_checkbox
                            active: root.right_hand_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_right_hand_toggle(self.active)
