#:kivy 2.0
#:import dp kivy.metrics.dp

<PilotageScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== ACTIONS DU JEU (masqué tant que le joueur est dans le Menu) ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.game_state != "Menu" else 0
                opacity: 1 if root.game_state != "Menu" else 0
                disabled: root.game_state == "Menu"

                MDLabel:
                    text: "ACTIONS DU JEU"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    spacing: dp(10)
                    radius: [12]
                    size_hint_y: None
                    height: dp(72)
                    elevation: 0
                    disabled: not root.unity_connected

                    MDRectangleFlatIconButton:
                        text: "Pause"
                        icon: "pause-circle-outline"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.pause_game()

                    MDRectangleFlatIconButton:
                        text: "Reprendre"
                        icon: "play-circle-outline"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.resume_game()

                    MDRectangleFlatIconButton:
                        text: "Restart"
                        icon: "restart"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        pos_hint: {"center_y": 0.5}
                        on_release: root.restart_game()

            # ==== PROFIL DU JOUEUR ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "JOUEUR"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "account"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Joueur"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    MDRectangleFlatIconButton:
                        id: player_selector_button
                        text: root.player_name if root.player_name else "Aucun joueur sélectionné"
                        icon: "account-switch"
                        size_hint_x: 1
                        size_hint_y: None
                        height: dp(48)
                        on_release: root.open_player_menu(self)

            # ==== MODE DE JEU ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "MODE DE JEU"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "cog-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Mode de jeu"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(10)
                        size_hint_y: None
                        height: dp(48)

                        MDRectangleFlatIconButton:
                            id: model_selector_button
                            text: root.MODEL_LABELS[root.pending_model]
                            icon: "menu-swap"
                            size_hint_x: 0.75
                            size_hint_y: None
                            height: dp(48)
                            on_release: root.open_model_menu(self)

                        MDRaisedButton:
                            text: "Appliquer"
                            size_hint_x: 0.25
                            size_hint_y: None
                            height: dp(48)
                            disabled: root.pending_model == root.selected_model
                            on_release: root.apply_model_change()

                    # ---- Options du mode Fixe ----
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: 0, dp(12), 0, 0
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height if root.pending_model == "FIXE" else 0
                        opacity: 1 if root.pending_model == "FIXE" else 0
                        disabled: root.pending_model != "FIXE"

                        MDTextField:
                            id: cube_frequency_field
                            text: str(int(root.cube_per_min))
                            hint_text: "Cubes par minute"
                            icon_left: "speedometer"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            on_text_validate: root.on_cube_frequency_submit(self.text)
                            on_focus: root.on_cube_frequency_submit(self.text) if not self.focus else None

                    # ---- Options du mode Incrémental ----
                    MDBoxLayout:
                        orientation: "horizontal"
                        padding: 0, dp(12), 0, 0
                        spacing: dp(10)
                        size_hint_y: None
                        height: self.minimum_height if root.pending_model == "INCREMENTAL" else 0
                        opacity: 1 if root.pending_model == "INCREMENTAL" else 0
                        disabled: root.pending_model != "INCREMENTAL"

                        MDTextField:
                            id: incremental_steps_field
                            text: str(int(root.incremental_steps))
                            hint_text: "Nombre de paliers"
                            icon_left: "stairs"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            on_text_validate: root.on_incremental_steps_submit(self.text)
                            on_focus: root.on_incremental_steps_submit(self.text) if not self.focus else None

                        MDTextField:
                            id: incremental_min_cpm_field
                            text: str(int(root.incremental_min_cpm))
                            hint_text: "Cpm minimum"
                            icon_left: "arrow-collapse-down"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            on_text_validate: root.on_incremental_min_cpm_submit(self.text)
                            on_focus: root.on_incremental_min_cpm_submit(self.text) if not self.focus else None

                        MDTextField:
                            id: incremental_max_cpm_field
                            text: str(int(root.incremental_max_cpm))
                            hint_text: "Cpm maximum"
                            icon_left: "arrow-collapse-up"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            on_text_validate: root.on_incremental_max_cpm_submit(self.text)
                            on_focus: root.on_incremental_max_cpm_submit(self.text) if not self.focus else None

                    # ---- Options des modes PID / DRL ----
                    MDBoxLayout:
                        orientation: "vertical"
                        padding: 0, dp(12), 0, 0
                        spacing: dp(14)
                        size_hint_y: None
                        height: self.minimum_height if root.pending_model in ("PID", "DRL") else 0
                        opacity: 1 if root.pending_model in ("PID", "DRL") else 0
                        disabled: root.pending_model not in ("PID", "DRL")

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(10)
                            size_hint_y: None
                            height: self.minimum_height

                            MDTextField:
                                id: target_hr_field
                                text: str(int(root.target_hr))
                                hint_text: "FC cible (% FCmax)"
                                icon_left: "target"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_target_hr_submit(self.text)
                                on_focus: root.on_target_hr_submit(self.text) if not self.focus else None

                            MDTextField:
                                id: adaptive_min_cpm_field
                                text: str(int(root.adaptive_min_cpm))
                                hint_text: "Cpm minimum"
                                icon_left: "arrow-collapse-down"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_adaptive_min_cpm_submit(self.text)
                                on_focus: root.on_adaptive_min_cpm_submit(self.text) if not self.focus else None

                            MDTextField:
                                id: adaptive_max_cpm_field
                                text: str(int(root.adaptive_max_cpm))
                                hint_text: "Cpm maximum"
                                icon_left: "arrow-collapse-up"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: app.theme_cls.primary_color
                                hint_text_color_focus: app.theme_cls.primary_color
                                line_color_focus: app.theme_cls.primary_color
                                icon_left_color_focus: app.theme_cls.primary_color
                                on_text_validate: root.on_adaptive_max_cpm_submit(self.text)
                                on_focus: root.on_adaptive_max_cpm_submit(self.text) if not self.focus else None

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(36)

                            MDIcon:
                                icon: "timer-play-outline"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "26sp"
                                size_hint: None, None
                                size: dp(30), dp(30)
                                pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "Warmup"
                                font_style: "Body1"
                                halign: "left"
                                valign: "center"

                            MDCheckbox:
                                id: warmup_checkbox
                                active: root.warmup_enabled
                                pos_hint: {"center_y": 0.5}
                                size_hint: None, None
                                size: dp(36), dp(36)
                                on_active: root.on_warmup_toggle(self.active)
                                disabled: not root.unity_connected

                        MDTextField:
                            id: warmup_duration_field
                            text: str(int(root.warmup_duration))
                            hint_text: "Durée du warmup (s)"
                            icon_left: "timer-sand"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            disabled: not root.unity_connected or not root.warmup_enabled
                            on_text_validate: root.on_warmup_duration_submit(self.text)
                            on_focus: root.on_warmup_duration_submit(self.text) if not self.focus else None

                    # ---- Signal FC requis (modes Fixe / Incrémental) ----
                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36) if root.pending_model in ("FIXE", "INCREMENTAL") else 0
                        opacity: 1 if root.pending_model in ("FIXE", "INCREMENTAL") else 0
                        disabled: root.pending_model not in ("FIXE", "INCREMENTAL")

                        MDIcon:
                            icon: "heart-pulse"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "26sp"
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Signal FC requis"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: require_hr_signal_checkbox
                            active: root.require_hr_signal
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_require_hr_signal_toggle(self.active)
                            disabled: not root.unity_connected

                    # ---- Alerte signal FC requis (modes PID / DRL) ----
                    MDCard:
                        orientation: "horizontal"
                        padding: dp(10), dp(6)
                        radius: [8]
                        spacing: dp(8)
                        size_hint_y: None
                        height: dp(36) if root.pending_model in ("PID", "DRL") else 0
                        opacity: 1 if root.pending_model in ("PID", "DRL") else 0
                        disabled: root.pending_model not in ("PID", "DRL")
                        elevation: 0
                        md_bg_color: AMBER_BG

                        MDIcon:
                            icon: "alert-circle-outline"
                            theme_text_color: "Custom"
                            text_color: AMBER_FG
                            font_size: "20sp"
                            size_hint: None, None
                            size: dp(22), dp(22)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Ce mode nécessite un signal FC valide pour fonctionner"
                            theme_text_color: "Custom"
                            text_color: AMBER_FG
                            font_style: "Caption"
                            halign: "left"
                            valign: "center"

            # ==== DURÉE DE SESSION ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "DURÉE DE SESSION"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(130)
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "timer-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Durée de session"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDLabel:
                            text: "{} min".format(int(root.session_duration_min))
                            font_style: "H6"
                            theme_text_color: "Primary"
                            halign: "right"

                    MDSlider:
                        id: session_duration_slider
                        min: 1
                        max: 20
                        value: root.session_duration_min
                        step: 1
                        hint: True
                        hint_text: "{} min".format(int(self.value))
                        on_value: root.on_session_duration_change(self.value)
                        on_touch_up: root.on_session_duration_touch_up() if self.collide_point(*args[1].pos) else None

            # ==== OBSTACLES ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "OBSTACLES"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "cube-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Obstacles"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: obstacles_checkbox
                            active: root.obs_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_obstacles_toggle(self.active)
                            disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        size_hint_y: None
                        height: self.minimum_height

                        MDTextField:
                            id: obstacle_probability_field
                            text: str(int(root.obstacle_probability))
                            hint_text: "Probabilité d'apparition"
                            icon_left: "percent"
                            mode: "rectangle"
                            input_filter: "int"
                            text_color_focus: app.theme_cls.primary_color
                            hint_text_color_focus: app.theme_cls.primary_color
                            line_color_focus: app.theme_cls.primary_color
                            icon_left_color_focus: app.theme_cls.primary_color
                            disabled: not root.unity_connected or not root.obs_enabled
                            on_text_validate: root.on_obstacle_probability_submit(self.text)
                            on_focus: root.on_obstacle_probability_submit(self.text) if not self.focus else None

            # ==== MAINS ACTIVES ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDLabel:
                    text: "MAINS ACTIVES"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(114)
                    elevation: 0

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "hand-back-left"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "26sp"
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Main gauche"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: left_hand_checkbox
                            active: root.left_hand_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_left_hand_toggle(self.active)
                            disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(36)

                        MDIcon:
                            icon: "hand-back-right"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "26sp"
                            size_hint: None, None
                            size: dp(30), dp(30)
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "Main droite"
                            font_style: "Body1"
                            halign: "left"
                            valign: "center"

                        MDCheckbox:
                            id: right_hand_checkbox
                            active: root.right_hand_enabled
                            pos_hint: {"center_y": 0.5}
                            size_hint: None, None
                            size: dp(36), dp(36)
                            on_active: root.on_right_hand_toggle(self.active)
                            disabled: not root.unity_connected
