#:kivy 2.0
#:import dp kivy.metrics.dp

<HeadsetScreen>:

    ScrollView:
        do_scroll_x: False

        MDBoxLayout:
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== STATUT DU CASQUE ====
            MDCard:
                orientation: "horizontal"
                padding: dp(16)
                radius: [12]
                spacing: dp(10)
                size_hint_y: None
                height: dp(70)
                elevation: 0
                canvas.after:
                    Color:
                        rgba: GREEN_FG if root.casque_connecte else RED_FG
                    RoundedRectangle:
                        pos: self.pos
                        size: dp(4), self.height
                        radius: [dp(12), 0, 0, dp(12)]

                MDIcon:
                    icon: "virtual-reality"
                    theme_text_color: "Custom"
                    text_color: GREEN_FG if root.casque_connecte else RED_FG
                    font_size: "40sp"
                    size_hint_x: None
                    width: dp(50)

                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(2)

                    MDLabel:
                        text: root.casque_statut
                        font_style: "H6"
                        halign: "left"
                        valign: "bottom"

                    MDLabel:
                        text: "Casque prêt pour la séance" if root.casque_connecte else "Détectez ou renseignez l'adresse IP du casque"
                        font_style: "Caption"
                        theme_text_color: "Secondary"
                        halign: "left"
                        valign: "top"

                MDIconButton:
                    icon: "information-outline"
                    theme_text_color: "Custom"
                    text_color: "grey"
                    icon_size: "26sp"
                    pos_hint: {"center_y": 0.5}
                    on_release: root.afficher_info_casque()

            # ==== Détection et préparation du casque ====
            MDCard:
                orientation: "vertical"
                padding: dp(16)
                radius: [12]
                spacing: dp(15)
                size_hint_y: None
                height: self.minimum_height
                elevation: 0

                # ---- Détection du casque (titre à gauche, action à droite) ----
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(50)

                    MDIcon:
                        icon: "headset"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        font_size: "30sp"
                        size_hint: None, None
                        size: dp(50), dp(50)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Détection du casque"
                        font_style: "Body1"
                        halign: "left"
                        valign: "center"

                    MDSpinner:
                        size_hint: None, None
                        size: dp(24), dp(24)
                        pos_hint: {"center_y": 0.5}
                        active: root.casque_en_cours
                        opacity: 1 if root.casque_en_cours else 0

                    MDIconButton:
                        icon: "magnify"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(48), dp(48)
                        pos_hint: {"center_y": 0.5}
                        disabled: root.casque_en_cours
                        on_release: root.detecter_casque()

                # ---- Adresse IP (auto-remplie si détectée, sinon manuelle) ----
                MDTextField:
                    id: casque_ip_field
                    hint_text: "Adresse IP du casque"
                    icon_left: "ip-network-outline"
                    mode: "rectangle"
                    text: root.casque_ip
                    on_text: root.on_casque_ip_change(self.text)
                    disabled: root.casque_en_cours

                # ---- Alerte de zone (juste au-dessus de Préparer : s'applique au même moment) ----
                MDBoxLayout:
                    orientation: "horizontal"
                    spacing: dp(10)
                    size_hint_y: None
                    height: dp(36)

                    MDCheckbox:
                        id: limite_switch
                        active: root.casque_limite_active
                        disabled: root.casque_en_cours
                        on_active: root.on_toggle_limite(self.active)
                        size_hint: None, None
                        size: dp(36), dp(36)
                        pos_hint: {"center_y": 0.5}

                    MDLabel:
                        text: "Alerte de zone activée (recommandé)" if root.casque_limite_active else "Alerte de zone désactivée — dérogation"
                        font_style: "Caption"
                        halign: "left"
                        valign: "center"

                # ---- Préparer le casque (actif dès qu'une IP est renseignée) ----
                MDRaisedButton:
                    text: "Préparation..." if root.casque_en_cours else "Préparer le casque"
                    disabled: root.casque_en_cours or not root.casque_ip
                    size_hint_x: 1
                    size_hint_y: None
                    height: dp(48)
                    on_release: root.preparer_casque()
