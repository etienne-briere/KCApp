#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window
#:import MatplotFigure kivy_matplotlib_widget.uix.graph_widget
#:import GraphAwareScrollView ui.screens.tracking_screen.GraphAwareScrollView

<SessionRow>:
    orientation: "horizontal"
    spacing: dp(10)
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: app.theme_cls.divider_color
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(1)

    MDLabel:
        text: root.record.filename if root.record else ""
        halign: "left"
        valign: "center"

    MDIconButton:
        icon: "trash-can-outline"
        theme_text_color: "Custom"
        text_color: 0.776, 0.157, 0.157, 1
        icon_size: "22sp"
        pos_hint: {"center_y": 0.5}
        on_release: root.delete_callback(root)

    MDIconButton:
        icon: "download-circle-outline"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color
        icon_size: "22sp"
        pos_hint: {"center_y": 0.5}
        on_release: root.export_callback(root)

<TrackingScreen>:

    GraphAwareScrollView:
        do_scroll_x: False
        no_scroll_widget: hr_graph_widget

        MDBoxLayout:
            id: tracking_content
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== Valeurs en direct (FC + Cubes/min) ====
            MDBoxLayout:
                orientation: "horizontal" if Window.width >= dp(600) else "vertical"
                spacing: dp(15)
                size_hint_y: None
                height: dp(70) if Window.width >= dp(600) else dp(155)

                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(15)
                    size_hint: (0.5, 1) if Window.width >= dp(600) else (1, 0.5)
                    elevation: 0

                    MDIcon:
                        icon: "heart"
                        theme_text_color: "Custom"
                        text_color: "red"
                        font_size: "30sp"
                        size_hint_x: None
                        width: dp(30)

                    MDLabel:
                        text: "Fréquence cardiaque"
                        font_style: "Body1"
                        halign: "left"
                        valign: "middle"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_x: None
                        width: self.minimum_width
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: heart_rate_label
                            text: root.heart_rate_label
                            font_style: "H5"
                            theme_text_color: "Primary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "bpm"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.4}

                MDCard:
                    orientation: "horizontal"
                    padding: dp(16)
                    radius: [12]
                    spacing: dp(15)
                    size_hint: (0.5, 1) if Window.width >= dp(600) else (1, 0.5)
                    elevation: 0

                    MDIcon:
                        icon: "cube-outline"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primary_color
                        font_size: "30sp"
                        size_hint_x: None
                        width: dp(30)

                    MDLabel:
                        text: "Cubes par minute"
                        font_style: "Body1"
                        halign: "left"
                        valign: "middle"

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(4)
                        size_hint_x: None
                        width: self.minimum_width
                        pos_hint: {"center_y": 0.5}

                        MDLabel:
                            id: cpm_label
                            text: root.cpm_label
                            font_style: "H5"
                            theme_text_color: "Primary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        MDLabel:
                            text: "cpm"
                            font_style: "Caption"
                            theme_text_color: "Secondary"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.4}

            # ==== Graphique de l'évolution de la séance (titre + actions + card) ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)

                    MDLabel:
                        text: "ÉVOLUTION DE LA SÉANCE"
                        font_style: "Overline"
                        theme_text_color: "Secondary"
                        halign: "left"
                        padding: dp(16), 0
                        adaptive_size: True
                        pos_hint: {"center_y": 0.5}

                    Widget:  # pousse les boutons à droite

                    MDIconButton:
                        icon: "image-filter-center-focus-weak"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.center_graph()

                    MDIconButton:
                        icon: "restart"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.reset_graph()

                    MDIconButton:
                        icon: "download-circle-outline"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.export_session()

                MDCard:
                    orientation: "vertical"
                    padding: dp(10)
                    spacing: dp(8)
                    radius: [12]
                    size_hint_y: None
                    height: dp(320) + dp(44)
                    elevation: 0

                    MatplotFigure:
                        id: hr_graph_widget

                    # ==== Options d'affichage du graphique ====
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"
                        size_hint_y: None
                        height: dp(36) if Window.width >= dp(500) else dp(72)

                        MDBoxLayout:
                            orientation: "horizontal" if Window.width >= dp(500) else "vertical"
                            spacing: dp(20)
                            size_hint: None, None
                            size: self.minimum_size

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(8)
                                size_hint_x: None
                                width: self.minimum_width

                                MDCheckbox:
                                    active: root.show_target
                                    on_active: root.on_toggle_target(self.active)
                                    size_hint: None, None
                                    size: dp(30), dp(30)
                                    pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "%FC cible"
                                    font_style: "Caption"
                                    adaptive_size: True
                                    pos_hint: {"center_y": 0.5}

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(8)
                                size_hint_x: None
                                width: self.minimum_width

                                MDCheckbox:
                                    active: root.show_cpm
                                    on_active: root.on_toggle_cpm(self.active)
                                    size_hint: None, None
                                    size: dp(30), dp(30)
                                    pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "Cubes/min"
                                    font_style: "Caption"
                                    adaptive_size: True
                                    pos_hint: {"center_y": 0.5}

            # ==== Sessions passées en attente d'export ou de suppression ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.has_pending_sessions else 0
                opacity: 1 if root.has_pending_sessions else 0
                disabled: not root.has_pending_sessions

                MDLabel:
                    text: "SESSIONS À EXPORTER"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16), dp(1)
                    radius: [12]
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        id: pending_sessions_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
