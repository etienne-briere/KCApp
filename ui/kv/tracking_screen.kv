#:import dp kivy.metrics.dp
#:import Window kivy.core.window.Window
#:import MatplotFigure kivy_matplotlib_widget.uix.graph_widget
#:import GraphAwareScrollView ui.screens.tracking_screen.GraphAwareScrollView
#:set LIGHT_GREEN_FG (0.298, 0.686, 0.314, 1)

<SessionRow>:
    orientation: "horizontal"
    spacing: dp(8)
    padding: 0, dp(4)
    size_hint_y: None
    height: dp(56)
    canvas.before:
        Color:
            rgba: app.theme_cls.divider_color
        Rectangle:
            pos: self.x, self.y
            size: self.width, dp(1)

    MDTextField:
        id: filename_field
        text: root.record.filename if root.record else ""
        multiline: False
        font_size: "14sp"
        on_text: root.record.rename(self.text) if root.record else None

    # ---- Données incluses, centrées horizontalement dans la Card : ce que
    # CETTE session inclura à son prochain export. L'écart entre éléments
    # est porté par leur padding (et non par spacing) pour que l'icône
    # cible, masquée hors mode adaptatif, ne laisse pas de trou. ----
    AnchorLayout:
        anchor_x: "center"
        anchor_y: "center"

        MDBoxLayout:
            orientation: "horizontal"
            size_hint: None, None
            size: self.minimum_size

            # %FC cible : pas de case, incluse d'office si la session était
            # en mode adaptatif (voir SessionRow.on_record)
            MDBoxLayout:
                orientation: "horizontal"
                padding: (dp(5), 0) if root.include_target else (0, 0)
                size_hint_x: None
                width: self.minimum_width if root.include_target else 0
                opacity: 1 if root.include_target else 0

                MDIcon:
                    icon: "target"
                    theme_text_color: "Custom"
                    text_color: GREEN_FG
                    font_size: "16sp"
                    size_hint: None, None
                    size: (dp(20), dp(20)) if root.include_target else (0, 0)
                    pos_hint: {"center_y": 0.5}

            # Cubes/min : ni case ni icône, inclus d'office si la session en
            # contient (voir SessionRow.on_record)

            MDBoxLayout:
                orientation: "horizontal"
                spacing: dp(2)
                padding: dp(5), 0
                size_hint_x: None
                width: self.minimum_width

                MDCheckbox:
                    active: root.include_state
                    on_active: root.include_state = self.active
                    size_hint: None, None
                    size: dp(24), dp(24)
                    pos_hint: {"center_y": 0.5}

                MDIcon:
                    icon: "flag-variant-outline"
                    theme_text_color: "Custom"
                    text_color: PURPLE_FG
                    font_size: "16sp"
                    size_hint: None, None
                    size: dp(20), dp(20)
                    pos_hint: {"center_y": 0.5}

    MDIconButton:
        icon: "file-download-outline"
        theme_text_color: "Custom"
        text_color: app.theme_cls.primary_color
        icon_size: "22sp"
        pos_hint: {"center_y": 0.5}
        on_release: root.export_callback(root)

    MDIconButton:
        icon: "trash-can-outline"
        theme_text_color: "Custom"
        text_color: 0.776, 0.157, 0.157, 1
        icon_size: "22sp"
        pos_hint: {"center_y": 0.5}
        on_release: root.delete_callback(root)

<TrackingScreen>:

    GraphAwareScrollView:
        do_scroll_x: False
        no_scroll_widget: hr_graph_widget

        MDBoxLayout:
            id: tracking_content
            orientation: "vertical"
            spacing: dp(20)
            padding: dp(20)
            size_hint_y: None
            height: self.minimum_height

            # ==== Valeurs en direct (FC + Cubes/min) + réglages du mode de jeu ====
            MDBoxLayout:
                orientation: "vertical"
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: "horizontal" if Window.width >= dp(600) else "vertical"
                    spacing: dp(15)
                    size_hint_y: None
                    height: dp(70) if Window.width >= dp(600) else dp(155)

                    MDCard:
                        orientation: "horizontal"
                        padding: dp(16)
                        radius: [12]
                        spacing: dp(15)
                        size_hint: (0.5, 1) if Window.width >= dp(600) else (1, 0.5)
                        elevation: 0

                        MDIcon:
                            icon: "heart-off" if root.hr_signal_lost else "heart"
                            theme_text_color: "Custom"
                            text_color: "red"
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDBoxLayout:
                            orientation: "vertical"
                            spacing: dp(2)

                            MDLabel:
                                text: "Fréquence cardiaque"
                                font_style: "Body1" if Window.width >= dp(600) else "Body2"
                                halign: "left"
                                valign: "bottom"

                            # Signal perdu : le capteur s'est déconnecté tout seul
                            MDLabel:
                                text: "Signal perdu — reconnectez le capteur" if root.hr_signal_lost else f"{root.hrmax_percent_label} % FCmax · {root.patient_age} ans"
                                font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                theme_text_color: "Custom" if root.hr_signal_lost else "Secondary"
                                text_color: 0.776, 0.157, 0.157, 1
                                halign: "left"
                                valign: "top"

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(4)
                            size_hint_x: None
                            width: self.minimum_width
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: heart_rate_label
                                text: root.heart_rate_label
                                font_style: "H5" if Window.width >= dp(600) else "H6"
                                theme_text_color: "Secondary" if root.hr_signal_lost else "Primary"
                                adaptive_size: True
                                pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "bpm"
                                font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                theme_text_color: "Secondary"
                                adaptive_size: True
                                pos_hint: {"center_y": 0.4}

                    MDCard:
                        orientation: "horizontal"
                        padding: dp(16)
                        radius: [12]
                        spacing: dp(15)
                        size_hint: (0.5, 1) if Window.width >= dp(600) else (1, 0.5)
                        elevation: 0

                        MDIcon:
                            icon: "cube-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Cubes par minute"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "middle"

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(4)
                            size_hint_x: None
                            width: self.minimum_width
                            pos_hint: {"center_y": 0.5}

                            MDLabel:
                                id: cpm_label
                                text: root.cpm_label
                                font_style: "H5" if Window.width >= dp(600) else "H6"
                                theme_text_color: "Primary"
                                adaptive_size: True
                                pos_hint: {"center_y": 0.5}

                            MDLabel:
                                text: "cpm"
                                font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                theme_text_color: "Secondary"
                                adaptive_size: True
                                pos_hint: {"center_y": 0.4}

                # ---- Options du mode adaptatif (FC cible + cadence min/max) ----
                # Une seule card groupée (au lieu de 3) : ces 3 valeurs forment
                # ensemble la bande de cadence cible du contrôleur, pas 3
                # réglages indépendants. rectangle + hint_text fonctionnent ici
                # sans le défaut d'alignement rencontré précédemment : chaque
                # champ porte sa propre icône via icon_left plutôt qu'un
                # MDIcon frère dans la même rangée — c'était cette dernière
                # combinaison qui cassait le centrage du hint, pas
                # rectangle+hint_text en tant que tel (voir icon_left_color_*
                # ci-dessous pour la couleur permanente, pas juste au focus).
                #
                # Enveloppe à hauteur 0 quand masquée : l'espacement est porté
                # par son padding (et non par le spacing du parent), pour ne
                # pas laisser de trou dans les autres modes.
                MDBoxLayout:
                    orientation: "vertical"
                    padding: 0, dp(20), 0, 0
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height if root.target_available else 0
                    opacity: 1 if root.target_available else 0
                    disabled: not root.target_available

                    MDLabel:
                        text: "OPTIONS DU MODE"
                        font_style: "Overline"
                        theme_text_color: "Secondary"
                        halign: "left"
                        padding: dp(16), 0
                        adaptive_size: True

                    MDCard:
                        orientation: "vertical"
                        padding: dp(16)
                        radius: [12]
                        spacing: dp(15)
                        elevation: 0
                        size_hint_y: None
                        height: self.minimum_height
                        disabled: not root.unity_connected

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(30)

                            MDIcon:
                                icon: "tune-vertical"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "30sp"
                                size_hint_x: None
                                width: dp(30)

                            MDLabel:
                                text: "Mode adaptatif"
                                font_style: "Body1" if Window.width >= dp(600) else "Body2"
                                halign: "left"
                                valign: "center"

                        MDBoxLayout:
                            orientation: "horizontal" if Window.width >= dp(600) else "vertical"
                            spacing: dp(15)
                            size_hint_y: None
                            height: self.minimum_height

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(4)
                                size_hint_y: None
                                height: target_hr_field.height

                                MDTextField:
                                    id: target_hr_field
                                    text: str(int(root.target_hr))
                                    hint_text: "%FCmax cible"
                                    icon_left: "target"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: LIGHT_GREEN_FG
                                    hint_text_color_focus: LIGHT_GREEN_FG
                                    line_color_focus: LIGHT_GREEN_FG
                                    icon_left_color_normal: LIGHT_GREEN_FG
                                    icon_left_color_focus: LIGHT_GREEN_FG
                                    on_text_validate: root.on_target_hr_submit(self.text)
                                    on_focus: root.on_target_hr_submit(self.text) if not self.focus else None

                                # Boutons +/- : uniquement sur smartphone (disabled bloque
                                # le clic quel que soit le rendu ; set_size() de
                                # MDIconButton ignore de toute façon la largeur imposée,
                                # mais opacity: 0 suffit à les rendre invisibles).
                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_x: None
                                    width: dp(96) if Window.width < dp(600) else 0
                                    opacity: 1 if Window.width < dp(600) else 0
                                    disabled: Window.width >= dp(600)

                                    MDIconButton:
                                        icon: "minus"
                                        theme_text_color: "Custom"
                                        text_color: LIGHT_GREEN_FG
                                        on_release: root.step_field("target_hr_field", "on_target_hr_submit", -1, LIGHT_GREEN_FG)

                                    MDIconButton:
                                        icon: "plus"
                                        theme_text_color: "Custom"
                                        text_color: LIGHT_GREEN_FG
                                        on_release: root.step_field("target_hr_field", "on_target_hr_submit", 1, LIGHT_GREEN_FG)

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(4)
                                size_hint_y: None
                                height: adaptive_min_cpm_field.height

                                MDTextField:
                                    id: adaptive_min_cpm_field
                                    text: str(int(root.adaptive_min_cpm))
                                    hint_text: "Cadence minimale (cpm)"
                                    icon_left: "arrow-collapse-down"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: BLUE_FG
                                    hint_text_color_focus: BLUE_FG
                                    line_color_focus: BLUE_FG
                                    icon_left_color_normal: BLUE_FG
                                    icon_left_color_focus: BLUE_FG
                                    on_text_validate: root.on_adaptive_min_cpm_submit(self.text)
                                    on_focus: root.on_adaptive_min_cpm_submit(self.text) if not self.focus else None

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_x: None
                                    width: dp(96) if Window.width < dp(600) else 0
                                    opacity: 1 if Window.width < dp(600) else 0
                                    disabled: Window.width >= dp(600)

                                    MDIconButton:
                                        icon: "minus"
                                        theme_text_color: "Custom"
                                        text_color: BLUE_FG
                                        on_release: root.step_field("adaptive_min_cpm_field", "on_adaptive_min_cpm_submit", -5, BLUE_FG)

                                    MDIconButton:
                                        icon: "plus"
                                        theme_text_color: "Custom"
                                        text_color: BLUE_FG
                                        on_release: root.step_field("adaptive_min_cpm_field", "on_adaptive_min_cpm_submit", 5, BLUE_FG)

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(4)
                                size_hint_y: None
                                height: adaptive_max_cpm_field.height

                                MDTextField:
                                    id: adaptive_max_cpm_field
                                    text: str(int(root.adaptive_max_cpm))
                                    hint_text: "Cadence maximale (cpm)"
                                    icon_left: "arrow-collapse-up"
                                    mode: "rectangle"
                                    input_filter: "int"
                                    text_color_focus: BLUE_FG
                                    hint_text_color_focus: BLUE_FG
                                    line_color_focus: BLUE_FG
                                    icon_left_color_normal: BLUE_FG
                                    icon_left_color_focus: BLUE_FG
                                    on_text_validate: root.on_adaptive_max_cpm_submit(self.text)
                                    on_focus: root.on_adaptive_max_cpm_submit(self.text) if not self.focus else None

                                MDBoxLayout:
                                    orientation: "horizontal"
                                    size_hint_x: None
                                    width: dp(96) if Window.width < dp(600) else 0
                                    opacity: 1 if Window.width < dp(600) else 0
                                    disabled: Window.width >= dp(600)

                                    MDIconButton:
                                        icon: "minus"
                                        theme_text_color: "Custom"
                                        text_color: BLUE_FG
                                        on_release: root.step_field("adaptive_max_cpm_field", "on_adaptive_max_cpm_submit", -5, BLUE_FG)

                                    MDIconButton:
                                        icon: "plus"
                                        theme_text_color: "Custom"
                                        text_color: BLUE_FG
                                        on_release: root.step_field("adaptive_max_cpm_field", "on_adaptive_max_cpm_submit", 5, BLUE_FG)

                # ---- Options du mode fixe (cadence unique) ----
                # Même principe d'enveloppe à hauteur 0 et de card groupée
                # que le bloc adaptatif juste au-dessus.
                MDBoxLayout:
                    orientation: "vertical"
                    padding: 0, dp(20), 0, 0
                    spacing: dp(8)
                    size_hint_y: None
                    height: self.minimum_height if root.current_model == "FIXE" else 0
                    opacity: 1 if root.current_model == "FIXE" else 0
                    disabled: root.current_model != "FIXE"

                    MDLabel:
                        text: "OPTIONS DU MODE"
                        font_style: "Overline"
                        theme_text_color: "Secondary"
                        halign: "left"
                        padding: dp(16), 0
                        adaptive_size: True

                    MDCard:
                        orientation: "vertical"
                        padding: dp(16)
                        radius: [12]
                        spacing: dp(15)
                        elevation: 0
                        size_hint_y: None
                        height: self.minimum_height
                        disabled: not root.unity_connected

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(15)
                            size_hint_y: None
                            height: dp(30)

                            MDIcon:
                                icon: "tune-vertical"
                                theme_text_color: "Custom"
                                text_color: app.theme_cls.primary_color
                                font_size: "30sp"
                                size_hint_x: None
                                width: dp(30)

                            MDLabel:
                                text: "Mode fixe"
                                font_style: "Body1" if Window.width >= dp(600) else "Body2"
                                halign: "left"
                                valign: "center"

                        MDBoxLayout:
                            orientation: "horizontal"
                            spacing: dp(4)
                            size_hint_y: None
                            height: fixed_cpm_field.height

                            MDTextField:
                                id: fixed_cpm_field
                                text: str(int(root.fixed_cpm))
                                hint_text: "Cadence fixe (cpm)"
                                icon_left: "speedometer"
                                mode: "rectangle"
                                input_filter: "int"
                                text_color_focus: BLUE_FG
                                hint_text_color_focus: BLUE_FG
                                line_color_focus: BLUE_FG
                                icon_left_color_normal: BLUE_FG
                                icon_left_color_focus: BLUE_FG
                                on_text_validate: root.on_fixed_cpm_submit(self.text)
                                on_focus: root.on_fixed_cpm_submit(self.text) if not self.focus else None

                            MDBoxLayout:
                                orientation: "horizontal"
                                size_hint_x: None
                                width: dp(96) if Window.width < dp(600) else 0
                                opacity: 1 if Window.width < dp(600) else 0
                                disabled: Window.width >= dp(600)

                                MDIconButton:
                                    icon: "minus"
                                    theme_text_color: "Custom"
                                    text_color: BLUE_FG
                                    on_release: root.step_field("fixed_cpm_field", "on_fixed_cpm_submit", -5, BLUE_FG)

                                MDIconButton:
                                    icon: "plus"
                                    theme_text_color: "Custom"
                                    text_color: BLUE_FG
                                    on_release: root.step_field("fixed_cpm_field", "on_fixed_cpm_submit", 5, BLUE_FG)

            # ==== Graphique de l'évolution de la séance (titre + actions + card) ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height

                MDBoxLayout:
                    orientation: "horizontal"
                    size_hint_y: None
                    height: dp(32)

                    MDLabel:
                        text: "ÉVOLUTION DE LA SÉANCE"
                        font_style: "Overline"
                        theme_text_color: "Secondary"
                        halign: "left"
                        padding: dp(16), 0
                        adaptive_size: True
                        pos_hint: {"center_y": 0.5}

                    Widget:  # pousse les boutons à droite

                    MDIconButton:
                        icon: "folder-edit-outline"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        opacity: 1 if root.can_choose_export_folder else 0
                        disabled: not root.can_choose_export_folder
                        on_release: root.choose_export_folder()

                    MDIconButton:
                        icon: "image-filter-center-focus-weak"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.center_graph()

                    MDIconButton:
                        icon: "restart"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.reset_graph()

                    MDIconButton:
                        icon: "download-box-outline"
                        theme_text_color: "Custom"
                        text_color: "grey"
                        size_hint: None, None
                        size: dp(32), dp(32)
                        icon_size: "20sp"
                        pos_hint: {"center_y": 0.5}
                        on_release: root.queue_session_for_export()

                MDCard:
                    orientation: "vertical"
                    padding: dp(10)
                    spacing: dp(8)
                    radius: [12]
                    size_hint_y: None
                    height: dp(320) + dp(44)
                    elevation: 0

                    MatplotFigure:
                        id: hr_graph_widget

                    # ==== Options d'affichage du graphique ====
                    AnchorLayout:
                        anchor_x: "center"
                        anchor_y: "center"
                        size_hint_y: None
                        height: dp(36)

                        # Seule option restante : la %FC cible et les cubes/min
                        # s'affichent d'eux-mêmes (mode adaptatif / cpm reçus)
                        MDBoxLayout:
                            orientation: "horizontal"
                            size_hint: None, None
                            size: self.minimum_size

                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(8)
                                size_hint_x: None
                                width: self.minimum_width

                                MDCheckbox:
                                    active: root.show_game_state
                                    on_active: root.on_toggle_game_state(self.active)
                                    size_hint: None, None
                                    size: dp(30), dp(30)
                                    pos_hint: {"center_y": 0.5}

                                MDIcon:
                                    icon: "flag-variant-outline"
                                    theme_text_color: "Custom"
                                    text_color: PURPLE_FG
                                    font_size: "16sp"
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "État du jeu"
                                    font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                    adaptive_size: True
                                    pos_hint: {"center_y": 0.5}

                            # ---- PID de secours : visible seulement en mode DRL ----
                            MDBoxLayout:
                                orientation: "horizontal"
                                spacing: dp(8)
                                padding: (dp(20), 0, 0, 0) if root.current_model == "DRL" else (0, 0, 0, 0)
                                size_hint_x: None
                                width: self.minimum_width if root.current_model == "DRL" else 0
                                opacity: 1 if root.current_model == "DRL" else 0
                                disabled: root.current_model != "DRL"

                                MDCheckbox:
                                    active: root.pid_backup
                                    on_active: root.on_pid_backup_toggle(self.active)
                                    size_hint: None, None
                                    size: dp(30), dp(30)
                                    pos_hint: {"center_y": 0.5}
                                    disabled: not root.unity_connected

                                MDIcon:
                                    icon: "shield-refresh-outline"
                                    theme_text_color: "Custom"
                                    text_color: app.theme_cls.primary_color
                                    font_size: "16sp"
                                    size_hint: None, None
                                    size: dp(20), dp(20)
                                    pos_hint: {"center_y": 0.5}

                                MDLabel:
                                    text: "PID de secours"
                                    font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                    adaptive_size: True
                                    pos_hint: {"center_y": 0.5}

            # ==== CONTRÔLEUR EN COURS DE PARTIE (contrôleur hybride Unity) — uniquement en mode adaptatif (PID/DRL), pendant une partie en cours ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.game_state == "Playing" and root.target_available else 0
                opacity: 1 if root.game_state == "Playing" and root.target_available else 0
                disabled: not (root.game_state == "Playing" and root.target_available)

                MDLabel:
                    text: "CONTRÔLEUR EN COURS DE PARTIE"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(10), dp(16)
                    radius: [12]
                    spacing: dp(10)
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0
                    disabled: not root.unity_connected

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(15)
                        size_hint_y: None
                        height: dp(30)

                        MDIcon:
                            icon: "swap-horizontal-circle-outline"
                            theme_text_color: "Custom"
                            text_color: app.theme_cls.primary_color
                            font_size: "30sp"
                            size_hint_x: None
                            width: dp(30)

                        MDLabel:
                            text: "Contrôleur" if root.controller_state_label else "Aucune partie en cours"
                            font_style: "Body1" if Window.width >= dp(600) else "Body2"
                            halign: "left"
                            valign: "center"
                            adaptive_size: True
                            pos_hint: {"center_y": 0.5}

                        Widget:  # pousse le badge de raison à droite

                        # Badge "raison de la bascule" (texte = controller_badge_text,
                        # couleur = catégorie — voir TrackingScreen._controller_badge_category) :
                        # échauffement/début de partie/bascule auto de sécurité/commande tablette
                        MDCard:
                            orientation: "horizontal"
                            padding: dp(8), dp(2)
                            spacing: dp(6)
                            radius: [dp(10)]
                            md_bg_color: root.controller_badge_bg
                            elevation: 0
                            size_hint: None, None
                            size: (self.minimum_width, dp(22)) if root.controller_badge_text else (0, 0)
                            pos_hint: {"center_y": 0.5}
                            opacity: 1 if root.controller_badge_text else 0

                            # Point coloré devant le texte (dessiné, pas un
                            # caractère "•" — rendu trop petit/inconstant
                            # selon la police)
                            Widget:
                                size_hint: None, None
                                size: dp(8), dp(8)
                                pos_hint: {"center_y": 0.5}
                                canvas.before:
                                    Color:
                                        rgba: root.controller_badge_fg
                                    Ellipse:
                                        pos: self.pos
                                        size: self.size

                            MDLabel:
                                text: root.controller_badge_text
                                font_style: "Caption" if Window.width >= dp(600) else "Overline"
                                bold: True
                                theme_text_color: "Custom"
                                text_color: root.controller_badge_fg
                                adaptive_size: True
                                pos_hint: {"center_y": 0.5}

                    MDBoxLayout:
                        orientation: "horizontal"
                        spacing: dp(6)
                        size_hint_y: None
                        height: dp(48)

                        # ---- PID / DRL / DRL Run 3 : puce remplie verte pour celui
                        # réellement actif (root.active_controller_button), grise sinon —
                        # même style que PID warmup dans Pilotage ----
                        MDFillRoundFlatButton:
                            text: "PID"
                            md_bg_color: GREEN_BG if root.active_controller_button == "PID" else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.active_controller_button == "PID" else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            on_release: root.switch_controller("PID")

                        MDFillRoundFlatButton:
                            text: "DRL"
                            md_bg_color: GREEN_BG if root.active_controller_button == "DRL_DEPLOYED" else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.active_controller_button == "DRL_DEPLOYED" else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            on_release: root.switch_controller("DRL_DEPLOYED")

                        MDFillRoundFlatButton:
                            text: "DRL 3"
                            md_bg_color: GREEN_BG if root.active_controller_button == "DRL_RUN3" else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.active_controller_button == "DRL_RUN3" else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            on_release: root.switch_controller("DRL_RUN3")

                        MDFillRoundFlatButton:
                            text: "Manuel"
                            md_bg_color: GREEN_BG if root.active_controller_button == "MANUAL" else GRAY_BG
                            theme_text_color: "Custom"
                            text_color: GREEN_FG if root.active_controller_button == "MANUAL" else GRAY_FG
                            size_hint_x: 1
                            size_hint_y: None
                            height: dp(48)
                            on_release: root.apply_manual_cpm()

                    MDTextField:
                        id: manual_cpm_field
                        text: str(int(root.manual_cpm))
                        hint_text: "Cadence manuelle (cubes/min)"
                        icon_left: "hand-back-right-outline"
                        mode: "rectangle"
                        input_filter: "int"
                        text_color_focus: app.theme_cls.primary_color
                        hint_text_color_focus: app.theme_cls.primary_color
                        line_color_focus: app.theme_cls.primary_color
                        icon_left_color_focus: app.theme_cls.primary_color
                        on_text_validate: root.on_manual_cpm_submit(self.text)
                        on_focus: root.on_manual_cpm_submit(self.text) if not self.focus else None

            # ==== Sessions passées en attente d'export ou de suppression ====
            MDBoxLayout:
                orientation: "vertical"
                spacing: dp(8)
                size_hint_y: None
                height: self.minimum_height if root.has_pending_sessions else 0
                opacity: 1 if root.has_pending_sessions else 0
                disabled: not root.has_pending_sessions

                MDLabel:
                    text: "SESSIONS À EXPORTER"
                    font_style: "Overline"
                    theme_text_color: "Secondary"
                    halign: "left"
                    padding: dp(16), 0
                    adaptive_size: True

                MDCard:
                    orientation: "vertical"
                    padding: dp(16), dp(1)
                    radius: [12]
                    size_hint_y: None
                    height: self.minimum_height
                    elevation: 0

                    MDBoxLayout:
                        id: pending_sessions_list
                        orientation: "vertical"
                        size_hint_y: None
                        height: self.minimum_height
