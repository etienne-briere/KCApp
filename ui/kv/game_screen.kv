#:kivy 2.0
#:import dp kivy.metrics.dp

<GameScreen>:
    MDBoxLayout:
        orientation: "vertical"
        md_bg_color: "black"

        FloatLayout:

            # ===== Image =====
            Image:
                id: game_image
                fit_mode: "contain"
                size_hint: 1, 1
                pos_hint: {"x": 0, "y": 0}

            # ===== Message quand aucune image n'arrive =====
            MDLabel:
                text: "AUCUN SIGNAL"
                halign: "center"
                valign: "center"
                font_style: "H5"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 0.8
                size_hint: 1, 1
                pos_hint: {"x": 0, "y": 0}
                opacity: 0 if root.has_signal else 1

            # ===== Bandeau d'état (img/s, résolution, débit) =====
            MDLabel:
                text: root.status_text
                halign: "center"
                font_style: "Caption"
                theme_text_color: "Custom"
                text_color: 1, 1, 1, 0.7
                size_hint: 1, None
                height: dp(24)
                pos_hint: {"x": 0, "y": 0}
